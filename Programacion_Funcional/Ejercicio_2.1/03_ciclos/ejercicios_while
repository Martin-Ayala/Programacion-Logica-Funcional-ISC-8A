from os import system
if system("clear") != 0: system("cls")

print("\nCuenta atras:")
# Ejercicio 1: Cuenta atras
# Imprime los números del 10 al 1 usando un bucle while.

contador = 10

while contador >= 1:
    print(contador)
    
    contador -= 1

print("\nSuma de números pares:")
# Ejercicio 2: Suma de números pares (while)
# Calcula la suma de los números pares entre 1 y 20 (inclusive) usando un bucle while.

num = 1
suma = 0

while num <= 20:

    if num % 2 == 0:
        suma += num
        
    num += 1 

print(f"La suma total de los numeros pares es: {suma}")

print("\nFactorial de un numero:")
# Ejercicio 3: Factorial de un número
# Pide al usuario que introduzca un número entero positivo.
# Calcula su factorial usando un bucle while.
# El factorial de un número entero positivo es el producto de todos los números del 1 al ese número. Por ejemplo, el factorial de 5
# 5! = 5 x 4 x 3 x 2 x 1 = 120.

numero = -1
while numero < 0:
    try:
        numero = int(input("Introduce un numero entero positivo: "))
        if numero < 0:
            print("El numero debe ser positivo. Intenta otra vez.")
    except ValueError:
        print("Eso no es un numero valido. Intenta otra vez.")

factorial = 1
contador = numero

while contador > 0:
    factorial *= contador  
    contador -= 1          

print(f"El factorial de {numero} es: {factorial}")

print("\nValidación de contraseña:")
# Ejercicio 4: Validación de contraseña
# Pide al usuario que introduzca una contraseña.
# La contraseña debe tener al menos 8 caracteres.
# Usa un bucle while para seguir pidiendo la contraseña hasta que cumpla con los requisitos.
# Si la contraseña es válida, imprime "Contraseña válida".

contrasena = ""

while len(contrasena) < 8:

    contrasena = input("Introduce una contraseña (debe tener al menos 8 caracteres): ")
    
    if len(contrasena) < 8:
        print("La contraseña es demasiado corta. Intenta otra vez\n")

print("Contraseña valida.")

print("\nTabla de multiplicar:")
# Ejercicio 5: Tabla de multiplicar
# Pide al usuario que introduzca un número.
# Imprime la tabla de multiplicar de ese número (del 1 al 10) usando un bucle while.

numero = int(input("Introduce un número para ver su tabla de multiplicar: "))

multiplicador = 1

print(f"\nTabla del {numero}")

while multiplicador <= 10:

    resultado = numero * multiplicador
    
    print(f"{numero} x {multiplicador} = {resultado}")
    
    multiplicador += 1

print("\nNumeros primos hasta N:")
# Ejercicio 6: Números primos hasta N
# Pide al usuario que introduzca un número entero positivo N.
# Imprime todos los números primos menores o iguales que N usando un bucle while.

n = int(input("Introduce un numero entero positivo N: "))

print(f"\nNúmeros primos menores o iguales a {n}:")

numero_actual = 2

while numero_actual <= n:
    es_primo = True
    divisor = 2
    
    while divisor < numero_actual:
        if numero_actual % divisor == 0:
            es_primo = False
            break
        
        divisor += 1
        
    if es_primo:
        print(numero_actual)
        
    numero_actual += 1